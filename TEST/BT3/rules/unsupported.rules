# Rule dung keyword ngoai pham vi - dung cho test case 03
alert tcp any any -> any 80 (msg:"Dung pcre"; pcre:"/admin/i"; sid:900201; rev:1;)
alert tcp any any -> any 80 (msg:"Dung byte_test"; byte_test:4,>,100,0; sid:900202; rev:1;)
